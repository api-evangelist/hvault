{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Vault Vault Auth Methods AppRole LDAP API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Vault-Token",
      "value": "{{X-Vault-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "LDAP",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HashiCorp Vault Login with LDAP",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/auth/ldap/login/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "LDAP username"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates with Vault using LDAP credentials."
        }
      ]
    }
  ],
  "bundled": true
}