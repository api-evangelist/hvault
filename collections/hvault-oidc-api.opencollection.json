{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Vault Vault Auth Methods AppRole OIDC API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Vault-Token",
      "value": "{{X-Vault-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "OIDC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HashiCorp Vault Read OIDC token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/identity/oidc/token/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the OIDC role"
              }
            ]
          },
          "docs": "Generates an OIDC identity token for the requesting entity based on the named role."
        },
        {
          "info": {
            "name": "HashiCorp Vault Read OIDC discovery configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/identity/oidc/.well-known/openid-configuration"
          },
          "docs": "Returns the OIDC discovery document for Vault's identity OIDC provider."
        },
        {
          "info": {
            "name": "HashiCorp Vault Read OIDC JWKS",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/identity/oidc/.well-known/keys"
          },
          "docs": "Returns the public keys used to verify OIDC identity tokens."
        }
      ]
    }
  ],
  "bundled": true
}