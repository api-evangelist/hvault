{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Vault Vault Auth Methods AppRole JWT/OIDC API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Vault-Token",
      "value": "{{X-Vault-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "JWT/OIDC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HashiCorp Vault Login with JWT/OIDC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/auth/jwt/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates with Vault using a JWT token."
        }
      ]
    }
  ],
  "bundled": true
}