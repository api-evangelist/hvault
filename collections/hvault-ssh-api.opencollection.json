{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Vault Vault Auth Methods AppRole SSH API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Vault-Token",
      "value": "{{X-Vault-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "SSH",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HashiCorp Vault Sign SSH key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/ssh/sign/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the SSH role"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Signs the provided public key using the named SSH role."
        }
      ]
    }
  ],
  "bundled": true
}