{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Vault Vault Auth Methods AppRole AWS API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Vault-Token",
      "value": "{{X-Vault-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AWS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "HashiCorp Vault Generate AWS credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/aws/creds/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ]
          },
          "docs": "Generates dynamic AWS access credentials based on the named role."
        },
        {
          "info": {
            "name": "HashiCorp Vault Read AWS role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/aws/roles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ]
          },
          "docs": "Reads the configuration for the named AWS role."
        },
        {
          "info": {
            "name": "HashiCorp Vault Create or update AWS role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/aws/roles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates the named AWS role."
        },
        {
          "info": {
            "name": "HashiCorp Vault Delete AWS role",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://vault.example.com/v1/aws/roles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ]
          },
          "docs": "Deletes the named AWS role."
        }
      ]
    }
  ],
  "bundled": true
}