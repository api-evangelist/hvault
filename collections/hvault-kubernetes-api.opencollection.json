          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/auth/kubernetes/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates with Vault using a Kubernetes service account JWT token."
        },
        {
          "info": {
            "name": "HashiCorp Vault Read Kubernetes auth configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/auth/kubernetes/config"
          },
          "docs": "Returns the Kubernetes auth method configuration."
        },
        {
          "info": {
            "name": "HashiCorp Vault Configure Kubernetes auth",
