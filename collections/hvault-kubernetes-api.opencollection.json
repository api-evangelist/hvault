            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates the named Kubernetes auth role."
        },
        {
          "info": {
            "name": "HashiCorp Vault Delete Kubernetes role",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://vault.example.com/v1/auth/kubernetes/role/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ]
