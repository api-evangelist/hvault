              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configures the Kubernetes auth method."
        },
        {
          "info": {
            "name": "HashiCorp Vault Read Kubernetes role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vault.example.com/v1/auth/kubernetes/role/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the role"
              }
            ]
          },
          "docs": "Reads the named Kubernetes auth role configuration."
        },
        {
          "info": {
            "name": "HashiCorp Vault Create or update Kubernetes role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://vault.example.com/v1/auth/kubernetes/role/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
